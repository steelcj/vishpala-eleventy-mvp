#!/bin/sh
# .githooks/pre-commit
#
# Regenerates content/_registry/ (works + expressions) from the current
# state of content/**/*.md front matter, then stages the result — so
# every commit that touches content also carries an up-to-date registry,
# never a stale one.
#
# Activated by `npm run prepare` (or a fresh `npm install`), which sets
# git's core.hooksPath to .githooks/. See scripts/setup-git-hooks.js.

node scripts/build-registry.js || exit 1
git add content/_registry
